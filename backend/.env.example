# NiyamDrishti Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# Full description of each var: docs/11_SECRETS_CHECKLIST.md
# Every variable listed here as MVP is required for Phase 1 to run end-to-end.

# -----------------------------------------------------------------------
# App
# -----------------------------------------------------------------------
APP_ENV=development
# Options: development | staging | production

# -----------------------------------------------------------------------
# JWT Auth  (MVP)
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------
# Database  (MVP)
# Local dev: SQLite (no Docker needed)
#   DATABASE_URL=sqlite+aiosqlite:///./niyamdrishti.db
# Local dev with Docker: Postgres (matches Neon in prod)
#   DATABASE_URL=postgresql+asyncpg://niyam:niyam@localhost:5432/niyamdrishti
# Production (Neon):
#   DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/niyamdrishti?sslmode=require
# -----------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./niyamdrishti.db

# -----------------------------------------------------------------------
# Cloudflare R2  (MVP)
# Get from: Cloudflare dashboard -> R2 -> Manage API Tokens
# R2_ENDPOINT_URL format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# -----------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=niyamdrishti-media
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
# Local dev (MinIO stand-in via Docker):
#   R2_ENDPOINT_URL=http://localhost:9000
#   R2_ACCESS_KEY_ID=minioadmin
#   R2_SECRET_ACCESS_KEY=minioadmin

# -----------------------------------------------------------------------
# SMTP Email  (MVP)
# Default: Gmail SMTP. Enable 2FA on the Gmail account first.
# App Password: Google Account -> Security -> App Passwords
# See ADR-003 in docs/09_DECISIONS.md for why Gmail over Resend.
# -----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-project-gmail@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------------
# OCR  (MVP)
# OCR_MODEL_CACHE_DIR: where PaddleOCR caches model files.
# On Render free tier, use /tmp (writable, non-persistent — models re-download on each cold start).
# Locally, use a persistent path like ~/.paddleocr or ./ocr_models
# -----------------------------------------------------------------------
PADDLEOCR_LANG=en
OCR_MODEL_CACHE_DIR=./ocr_models

# -----------------------------------------------------------------------
# Rule Engine  (MVP)
# Set after RULE-02 seeds the initial rule pack.
# Must be explicit — never silently "latest" without an admin action.
# -----------------------------------------------------------------------
ACTIVE_RULE_PACK_VERSION=

# -----------------------------------------------------------------------
# CORS  (MVP)
# Comma-separated list of allowed frontend origins.
# -----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------
# Future phases — DO NOT provision yet
# -----------------------------------------------------------------------
# BREVO_API_KEY=           # Phase 2+ email scale-up (ADR-003)
# BHASHINI_API_KEY=        # Phase 3 (E3-04) - OQ-07
# BHASHINI_USER_ID=        # Phase 3 (E3-04)
